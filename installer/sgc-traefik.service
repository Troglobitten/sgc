[Unit]
Description=Traefik (the reverse proxy for the home network's names), installed by Server Gateway Control
Documentation=https://github.com/Troglobitten/sgc
After=network.target
# Only once Traefik has been installed, and only while the owner has the
# proxy switched on. The installer and the updater make every unit with an
# [Install] section part of start-up; the file "on" is what SGC's own switch
# sets (internal/proxy), so a proxy the owner left off stays off after a
# restart.
ConditionPathExists=/opt/sgc/components/traefik/current/traefik
ConditionPathExists=/etc/sgc/traefik/on

[Service]
# Traefik passes requests for the names under the owner's domain on to the
# devices behind them. It is a program of its own, under an account of its
# own, and keeps running when SGC does not: its configuration is in files
# that SGC's root side writes (internal/proxy), not in SGC.
Type=simple
User=sgc-traefik
Group=sgc-traefik
ExecStart=/opt/sgc/components/traefik/current/traefik --configFile=/etc/sgc/traefik/traefik.yml
Restart=on-failure
RestartSec=3

# --- Sandboxing ---------------------------------------------------------
# One privilege: listening on ports below 1024 (80 and 443, and any port the
# owner gives a proxied service). It writes nowhere.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
