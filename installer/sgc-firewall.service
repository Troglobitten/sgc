[Unit]
Description=Server Gateway Control firewall rules
Documentation=https://github.com/Troglobitten/sgc
# Loaded before any network interface comes up, so there is no moment after
# start-up in which the device answers without its firewall. The same
# ordering as Debian's own nftables.service.
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
# Nothing to do until a firewall change has been confirmed for the first time.
ConditionPathExists=/etc/sgc/firewall.nft

[Service]
Type=oneshot
RemainAfterExit=yes
# Deliberately the plain nft program and not one of SGC's own: the confirmed
# rules load even if SGC itself is missing or broken. Only confirmed rules
# are ever in this file (see internal/firewall), so a restart always returns
# to rules the owner has confirmed working.
ExecStart=/usr/sbin/nft -f /etc/sgc/firewall.nft

# Kept close to Debian's unit, which is known to work this early in start-up.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=full
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=sysinit.target
