[Unit]
Description=Server Gateway Control SSH change
Documentation=https://github.com/Troglobitten/sgc
# The second safety net (the first is ExecStopPost below): a unit of its own
# that puts the confirmed SSH settings back if this one ended with a change
# still unconfirmed. See sgc-firewall-change.service, which works the same.
OnSuccess=sgc-ssh-revert.service
OnFailure=sgc-ssh-revert.service
# Never refused for having been started often (see sgc-firewall-change.service).
StartLimitIntervalSec=0

[Service]
# One run per change to the SSH server's keys or settings. The process puts
# the change into effect and reports "ready". If the change takes away a way
# of logging in (switching to keys only), it then stays and watches the SSH
# server's log: a login with a key makes the change permanent; two minutes
# without one, and the previous settings come back. Started by the helper;
# see internal/sshd.
Type=notify
NotifyAccess=main
ExecStart=/opt/sgc/current/sgc-helper ssh change
# The first safety net: run by systemd after the process above has ended,
# however it ended.
ExecStopPost=/opt/sgc/current/sgc-helper ssh revert
TimeoutStartSec=60
TimeoutStopSec=60
# On "stop", systemd signals only the main process, which then undoes the
# change. Without this line it signals every process of the unit, and that
# includes the small programs the main process starts to do the undoing
# (nft; for SSH: sshd, systemctl). They were sometimes killed in the middle,
# which left an unconfirmed change in effect. Found by the whole-machine test.
KillMode=mixed
# A process still here long after the two minutes is stuck.
RuntimeMaxSec=420

# --- Sandboxing ---------------------------------------------------------
# Root, because the SSH server only tells root what its settings amount to,
# but with no capabilities at all: the files this job writes belong to root
# anyway. It can write to SGC's own configuration folder, to SGC's one file
# among the SSH server's settings and to its folder in /run, nowhere else,
# and it cannot open network connections.
ConfigurationDirectory=sgc
RuntimeDirectory=sgc-ssh
RuntimeDirectoryPreserve=yes
ReadWritePaths=-/etc/ssh/sshd_config.d
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources
