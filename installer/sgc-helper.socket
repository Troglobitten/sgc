[Unit]
Description=Server Gateway Control helper socket
Documentation=https://github.com/Troglobitten/sgc

[Socket]
# systemd creates this socket, with these permissions, before any SGC code
# runs, and starts the helper the first time something connects to it.
# Only root and members of the sgc group (the web process) may connect.
ListenStream=/run/sgc-helper/helper.sock
SocketUser=root
SocketGroup=sgc
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
