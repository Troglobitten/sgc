[Unit]
Description=Server Gateway Control: install the Debian packages SGC needs
Documentation=https://github.com/Troglobitten/sgc

[Service]
# Installs, from Debian's own archive, the package one of SGC's features
# needs and a clean Debian may not bring (nftables for the firewall,
# unattended-upgrades for the device's updates). Started by the helper the
# first time that feature is switched on, for that feature only.
Type=oneshot
ExecStart=/opt/sgc/current/sgc-helper packages
# Includes refreshing Debian's package lists on a slow line and a slow card.
TimeoutStartSec=780

# No sandbox worth the name: installing a package means writing all over the
# system and running the package's own scripts, and restrictions here would
# only make that fail in surprising ways. What limits this job is what it can
# be asked to do: the lists of packages are fixed in the program, and the
# request to run it names a feature from that list, never a package.
PrivateTmp=yes
