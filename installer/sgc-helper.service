[Unit]
Description=Server Gateway Control helper (the few operations that need root)
Documentation=https://github.com/Troglobitten/sgc
Requires=sgc-helper.socket

[Service]
Type=simple
ExecStart=/opt/sgc/current/sgc-helper
Restart=on-failure
RestartSec=2

# --- Sandboxing ---------------------------------------------------------
# The helper must be root to do its job, but it needs very little else.
# It has no capabilities, cannot write anywhere, and cannot open network
# connections; it only answers on the socket systemd hands it, and asks
# systemd itself to carry out a restart.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources
